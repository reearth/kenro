{
  "name": "kenro-wasm",
  "version": "0.2.0",
  "description": "SpatiaLite-style spatial SQL for SQLite in the browser — PostGIS-compatible ST_ functions as UDFs for sql.js, wa-sqlite and the official SQLite WASM build",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reearth/kenro.git",
    "directory": "crates/kenro-wasm/js"
  },
  "homepage": "https://reearth.github.io/kenro/",
  "keywords": [
    "sqlite",
    "spatial",
    "gis",
    "postgis",
    "geopackage",
    "wasm",
    "sql.js",
    "wa-sqlite",
    "spatialite",
    "mvt",
    "geojson",
    "h3"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./pkg/kenro_wasm.js",
    "./pkg/kenro_wasm_bg.wasm": "./pkg/kenro_wasm_bg.wasm",
    "./sqlite-wasm": {
      "types": "./src/sqlite-wasm.d.ts",
      "default": "./src/sqlite-wasm.mjs"
    },
    "./sqljs": {
      "types": "./src/sqljs.d.ts",
      "default": "./src/sqljs.mjs"
    },
    "./wa-sqlite": {
      "types": "./src/wa-sqlite.d.ts",
      "default": "./src/wa-sqlite.mjs"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.mjs"
    },
    "./tiles": {
      "types": "./src/tiles.d.ts",
      "default": "./src/tiles.mjs"
    },
    "./quadtree": {
      "types": "./src/quadtree.d.ts",
      "default": "./src/quadtree.mjs"
    },
    "./prepared": {
      "types": "./src/prepared.d.ts",
      "default": "./src/prepared.mjs"
    }
  },
  "files": [
    "pkg",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "prepack": "node -e \"fs.rmSync(\\\"pkg/.gitignore\\\",{force:true});fs.rmSync(\\\"pkg/README.md\\\",{force:true})\"",
    "test": "node --test && npm run test:types",
    "bench": "node examples/index-comparison.mjs",
    "bench:check": "node examples/index-comparison.mjs --check",
    "test:types": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.50.0-build1",
    "sql.js": "^1.13.0",
    "typescript": "^5.7.0",
    "wa-sqlite": "^1.0.0"
  }
}
